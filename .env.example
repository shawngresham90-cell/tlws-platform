# ============================================================
# TLWS Platform — Environment Template
# Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================

# --- Supabase (public — safe to expose in browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://cgvxwvymkembftznhcdl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here

# --- Supabase (server-only — route handlers / Edge Functions ONLY) ---
# Bypasses RLS. Performs the writes anon is forbidden from. NEVER ships to the
# browser. Not used by the login flow (auth runs on the anon key + cookies).
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (form spam protection) ---
# Public site key goes in the form (NEXT_PUBLIC_ so it reaches the browser);
# secret verifies server-side. If the secret is unset: dev SKIPS verification
# (with a warning); production FAILS CLOSED.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Resend email (DORMANT until EMAIL_SENDING_ENABLED=true) ---
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SENDING_ENABLED=false

# --- Twilio SMS (DORMANT until SMS_SENDING_ENABLED=true) ---
# TCPA: never send without recorded consent. Sending stays off this milestone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_SENDING_ENABLED=false

# --- Stripe (placeholder; gated on EIN -> bank -> Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- On-demand revalidation (shared secret for trusted callers) ---
REVALIDATE_SECRET=

# --- Admin dashboard (Milestone 10 — server-only, protects /admin) ---
# Shared password to sign in at /admin/login.
ADMIN_PASSWORD=
# Random secret that signs the admin session cookie (e.g. `openssl rand -hex 32`).
# Both must be set or /admin is inaccessible (fails closed).
ADMIN_SESSION_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://truckinglifewithshawn.com

# --- Trip Planner live providers (server-only; both fail-soft when unset) ---
# EIA open data (free key: eia.gov/opendata) — regional diesel prices.
EIA_API_KEY=
# HERE Base Plan key (free: platform.here.com) — powers BOTH live truck-legal
# routing (Routing API v8) AND free-text origin/destination geocoding
# (Geocoding & Search v7). One key, one shared free tier. Server-side ONLY;
# never expose in the browser.
HERE_API_KEY=

# --- Navigator access (server-only; changeable without a rebuild) ---
# Who may reach /drive, /navigator and the two /api/navigator/* endpoints.
#   closed  Navigator unavailable — the surfaces answer 404.
#   pilot   The shared passcode below is required. THE DEFAULT.
#   public  No passcode. Anyone may enter.
# Unset, misspelt, or anything not exactly one of the three resolves to
# `pilot`. That fallback is deliberate: every failure that can reach this
# variable looks the same from inside the process, and the only safe reading
# of "I don't know" is the closed-ish one.
#
# DO NOT SET THIS TO `public` YET. There is no ceiling on total provider
# spend that survives a serverless host running many instances, and the
# documented free allowance is 5,000 truck transactions a month. Read
# docs/operations/navigator-public-beta-cost-audit.md first — it lists
# exactly what has to be true before this is safe to flip.
#   account No passcode. A driver verifies an email address and signs in.
#           Anonymous callers get nothing at all — which is narrower than
#           `public`, where a stranger reaches a metered routing endpoint.
#           DO NOT SET THIS IN PRODUCTION YET. It requires migrations 049-052
#           applied, working custom SMTP, and the three budget variables
#           below. See docs/operations/navigator-account-launch-readiness.md.
NAVIGATOR_ACCESS_MODE=pilot
# The pilot passcode. Server-side only; never NEXT_PUBLIC_. Used to sign the
# access cookie, so rotating it invalidates every issued cookie at once.
NAVIGATOR_PREVIEW_PASSWORD=

# --- Navigator provider budget (server-only; account and public modes) ------
# The centralized monthly spend guard. Its counter is one Postgres row every
# serverless instance contends for, because a per-process counter cannot bound
# a monthly bill however global the variable looks.
#
# ALL THREE ARE REQUIRED IN `account` MODE AND IT FAILS CLOSED WITHOUT THEM:
# a metered request is refused when these are missing, unparseable or
# self-contradictory. That is deliberate. Inert in `pilot` and `closed`, so the
# live pilot gains no new dependency on Supabase being reachable.
#
# Parsing is strict: '', 'abc', '12.5', '-1' and '0' are all rejected rather
# than coerced, because Number('') is 0 and a threshold of zero would refuse
# every request while looking like a deliberate setting.
#
# The allowance you believe you have. Not enforced against traffic; it exists
# so the threshold can be sanity-checked against it. Set it to what HERE
# actually contracts you — routing and search bill against DIFFERENT products
# with different quotas, and the search quota is undocumented.
NAVIGATOR_PROVIDER_MONTHLY_ALLOWANCE=
# The number actually enforced. MUST BE STRICTLY BELOW THE ALLOWANCE — equal is
# rejected as a configuration error, because the margin between the two numbers
# is the entire reason there are two of them.
NAVIGATOR_PROVIDER_MONTHLY_THRESHOLD=
# Per-driver monthly ceiling, keyed to the verified auth.uid() — never an IP,
# because an IP is a whole carrier's NAT and also one moving truck's.
NAVIGATOR_PROVIDER_USER_MONTHLY_LIMIT=
# Optional. Units charged per call to each metered endpoint. Default 1 each.
NAVIGATOR_PROVIDER_WEIGHT_ROUTE=
NAVIGATOR_PROVIDER_WEIGHT_SEARCH=
# Build-time master switch. Unless this is exactly 'true', every Navigator
# surface 404s regardless of the access mode above.
NEXT_PUBLIC_NAVIGATOR_ENABLED=false

# --- Plausible Analytics (cookieless, optional) ---
# Set to the site's domain (e.g. truckinglifewithshawn.com) to enable
# analytics. Leave unset to ship zero analytics bytes (all trackEvent calls
# no-op safely). This is a public value, not a secret.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
